---
import { buildDocsIndex } from "@/lib/docs-index";
import Logo from "@/components/Logo.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import Base from "./Base.astro";

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
const docsIndex = await buildDocsIndex();
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (path: string) => currentPath === path || currentPath === `${path}/`;
---

<Base title={`${title} | Fatima`} description={description}>
	<div class="flex min-h-screen justify-center">
		<div class="min-h-screen w-full max-w-[var(--container-max-width)] border-x border-b border-border max-md:border-x-0">
			<header class="sticky top-0 z-[100] border-b border-border bg-background">
				<div class="flex min-h-[var(--header-height)] items-center justify-between px-[var(--section-padding-x)] py-5 max-md:px-5">
					<a href="/" class="flex items-center gap-2 text-base font-bold text-foreground-strong no-underline hover:no-underline">
						<Logo />
						<span>fatima</span>
					</a>
					<div class="flex items-center gap-3">
						<ThemeToggle />
						<button
							data-mobile-menu-button
							class="hidden size-10 items-center justify-center rounded-md border border-border bg-background text-foreground-strong max-md:inline-flex"
							aria-label="Open navigation menu"
							aria-expanded="false"
						>
							<span class="sr-only">Toggle navigation</span>
							<svg data-menu-icon="open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5">
								<path d="M4 8h16M4 16h16" />
							</svg>
							<svg data-menu-icon="close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="hidden size-5">
								<path d="m6 6 12 12M18 6 6 18" />
							</svg>
					</button>
						<nav class="flex items-center gap-6 max-md:hidden">
						<a href="https://github.com/Fgc17/fatima" target="_blank" rel="noreferrer">GitHub</a>
						<a href="/docs">Docs</a>
					</nav>
					</div>
				</div>
			</header>

			<main class="px-[var(--section-padding-x)] pt-6 pb-12 max-md:px-5">
				<div data-mobile-nav-overlay class="fixed inset-0 z-[90] hidden bg-black/35 opacity-0 transition-opacity max-md:block"></div>
				<div class="grid grid-cols-[var(--sidebar-width)_minmax(0,1fr)] gap-12 max-md:grid-cols-1">
					<aside data-docs-sidebar class="sticky top-[calc(var(--header-height)+24px)] h-fit max-h-[calc(100vh-var(--header-height)-48px)] overflow-auto pb-6 max-md:fixed max-md:top-[var(--header-height)] max-md:left-0 max-md:bottom-0 max-md:z-[101] max-md:hidden max-md:w-[min(320px,100%)] max-md:max-h-none max-md:-translate-x-full max-md:border-r max-md:border-border max-md:bg-background max-md:px-5 max-md:py-6 max-md:transition-transform">
						<div>
							<div class="mb-2 text-xs font-semibold tracking-[0.04em] uppercase text-foreground-strong">Overview</div>
							<ul class="list-none p-0 m-0">
								<li><a href="/docs" class:list={{ active: isActive("/docs") }} class="block py-1 text-[13px] text-foreground no-underline hover:text-foreground-strong hover:no-underline active:text-foreground-strong">Why Fatima?</a></li>
							</ul>
						</div>
						{
							docsIndex.sections.map((section) => (
								<div class="mt-5">
									<div class="mb-2 text-xs font-semibold tracking-[0.04em] uppercase text-foreground-strong">{section.title}</div>
									<ul class="list-none p-0 m-0">
										{section.pages.map((page) => (
											<li>
												<a
													href={page.url}
													class:list={{ active: isActive(page.url) }}
													class="block py-1 text-[13px] text-foreground no-underline hover:text-foreground-strong hover:no-underline active:text-foreground-strong"
												>
													{page.navTitle}
												</a>
											</li>
										))}
									</ul>
								</div>
							))
						}
					</aside>

					<article class="docs-content min-w-0 max-w-[var(--content-width)] [overflow-wrap:anywhere]">
						<slot />
					</article>
				</div>
			</main>

			<footer class="mt-8 border-t border-border px-[var(--section-padding-x)] py-5 max-md:px-5">
				<div class="flex justify-between gap-4 text-[13px] text-foreground max-md:flex-col max-md:items-start">
					<span>Fatima — safe secrets for the javascript ecosystem</span>
					<a href="https://github.com/Fgc17/fatima" target="_blank" rel="noreferrer">GitHub</a>
				</div>
			</footer>
		</div>
	</div>

	<script>
		const menuBtn = document.querySelector<HTMLElement>('[data-mobile-menu-button]')
		const sidebar = document.querySelector<HTMLElement>('[data-docs-sidebar]')
		const overlay = document.querySelector<HTMLElement>('[data-mobile-nav-overlay]')

		const setMenuState = (open: boolean) => {
			if (!menuBtn || !sidebar || !overlay) return
			menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false')
			document.body.classList.toggle('overflow-hidden', open)
			sidebar.classList.toggle('max-md:translate-x-0', open)
			sidebar.classList.toggle('max-md:-translate-x-full', !open)
			overlay.classList.toggle('hidden', !open)
			overlay.classList.toggle('opacity-100', open)
			overlay.classList.toggle('opacity-0', !open)
			menuBtn.querySelector<HTMLElement>('[data-menu-icon="open"]')?.classList.toggle('hidden', open)
			menuBtn.querySelector<HTMLElement>('[data-menu-icon="close"]')?.classList.toggle('hidden', !open)
		}

		function openMenu() {
			setMenuState(true)
		}

		function closeMenu() {
			setMenuState(false)
		}

		menuBtn?.addEventListener('click', () => {
			const isOpen = menuBtn.getAttribute('aria-expanded') === 'true'
			if (isOpen) closeMenu()
			else openMenu()
		})

		overlay?.addEventListener('click', closeMenu)

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
				closeMenu()
			}
		})

		sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu))

		document.querySelectorAll('.docs-content table').forEach((table) => {
			const wrapper = document.createElement('div')
			wrapper.className = 'table-wrapper'
			table.parentNode?.insertBefore(wrapper, table)
			wrapper.appendChild(table)
		})

			document.querySelectorAll<HTMLPreElement>('pre[data-code]').forEach((preElement) => {
			const btn = document.createElement('button')
			btn.className = 'copy-btn absolute top-2 right-2 rounded border border-border bg-background px-2 py-1 text-xs text-foreground transition-colors hover:bg-muted'
			btn.type = 'button'
			btn.setAttribute('aria-label', 'Copy code')
			btn.textContent = 'Copy'
			preElement.appendChild(btn)

			btn.addEventListener('click', async () => {
				await navigator.clipboard.writeText(preElement.dataset.code || '')
				btn.textContent = 'Copied'
				setTimeout(() => {
					btn.textContent = 'Copy'
				}, 1500)
			})
		})

		setMenuState(false)
	</script>
</Base>
