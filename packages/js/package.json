{
	"name": "@fatima.dev/js",
	"description": "JavaScript bindings for the Fatima native CLI",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly false --outDir dist --declarationMap false",
		"checktypes": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "24.9.1",
		"typescript": "6.0.3"
	}
}
