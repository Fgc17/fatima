{
	"name": "fatima",
	"description": "typesafe secrets for the javascript ecosystem",
	"author": "Fernando Coelho",
	"homepage": "https://fatimajs.vercel.app",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fgc17/fatima.git"
	},
	"keywords": [
		"env",
		"typesafe",
		"typescript",
		"environment",
		"variable"
	],
	"publishConfig": {
		"access": "public"
	},
	"version": "0.0.28",
	"license": "MIT",
	"type": "module",
	"bin": {
		"fatima": "./dist/index.cjs"
	},
	"main": "./dist/runtime.cjs",
	"types": "./dist/runtime.d.cts",
	"exports": {
		".": "./dist/runtime.cjs",
		"./cli": "./dist/index.cjs",
		"./register": "./dist/register.cjs"
	},
	"typesVersions": {
		"*": {
			".": [
				"./dist/runtime.d.cts"
			],
			"cli": [
				"./dist/index.d.cts"
			],
			"register": [
				"./dist/register.d.cts"
			]
		}
	},
	"files": [
		"dist"
	],
	"oclif": {
		"bin": "fatima",
		"dirname": "fatima",
		"commands": {
			"strategy": "explicit",
			"target": "./dist/index.cjs",
			"identifier": "COMMANDS"
		},
		"topicSeparator": " "
	},
	"scripts": {
		"checktypes": "tsc --noEmit",
		"build": "rm -rf dist && tsdown",
		"dev": "tsdown --watch"
	},
	"dependencies": {
		"@oclif/core": "^4.8.3",
		"chalk": "^5.6.2",
		"jiti": "2.6.1",
		"log-symbols": "^7.0.1",
		"oclif": "4.22.81",
		"ora": "^9.3.0",
		"unplugin-raw": "^0.6.4"
	},
	"devDependencies": {
		"@fatima/config": "workspace:*",
		"@types/node": "24.9.1",
		"prettier": "3.6.2",
		"tsdown": "0.21.4"
	}
}
