{
	"name": "fatima",
	"description": "typesafe secrets for the javascript ecosystem",
	"author": "Fernando Coelho",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.0.20",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fgc17/fatima.git"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"env",
		"typesafe",
		"typescript",
		"environment",
		"variable"
	],
	"type": "module",
	"main": "./dist/core/core.cjs",
	"types": "./dist/core/core.d.cts",
	"exports": {
		".": "./dist/core/core.cjs",
		"./lib": "./dist/lib/lib.cjs"
	},
	"typesVersions": {
		"*": {
			".": [
				"./dist/core/core.d.cts"
			],
			"lib": [
				"./dist/lib/lib.d.cts"
			]
		}
	},
	"bin": {
		"fatima": "./dist/cli/cli.cjs"
	},
	"scripts": {
		"------------- dev -------------": "-------------",
		"dev": "pnpm tsup --env.mode dev",
		"dev:bundlesize": "pnpm tsup --metafile && npm pack --dry-run",
		"------------- build -------------": "-------------",
		"typecheck": "tsc --noEmit",
		"build": "pnpm tsup --env.mode release",
		"bundlesize": "pnpm build --metafile && npm pack --dry-run",
		"------------- publishing -------------": "-------------",
		"release": "pnpm typecheck && pnpm build && pnpm publish --no-git-checks",
		"release:rc": "pnpm typecheck && pnpm build && pnpm version prerelease --preid=rc"
	},
	"devDependencies": {
		"@types/node": "^22.9.1",
		"terser": "^5.39.0",
		"tsup": "^8.3.5",
		"typescript": "5.6.3",
		"jiti": "2.4.2"
	},
	"dependencies": {
		"commander": "13.1.0"
	},
	"peerDependencies": {
		"@fatimajs/tools": "workspace:*"
	}
}
