{
	"name": "fatima",
	"description": "local-first encrypted secrets and typed environment access",
	"author": "Fernando Coelho",
	"homepage": "https://fatimajs.vercel.app",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fgc17/fatima.git"
	},
	"keywords": [
		"env",
		"typesafe",
		"typescript",
		"environment",
		"variable"
	],
	"publishConfig": {
		"access": "public"
	},
	"version": "1.0.1-rc.1",
	"license": "MIT",
	"type": "module",
	"bin": {
		"fatima": "./dist/fatima"
	},
	"main": "./dist/runtime.js",
	"types": "./dist/types/exports/runtime.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/exports/runtime.d.ts",
			"import": "./dist/runtime.js"
		},
		"./api": {
			"types": "./dist/types/exports/api.d.ts",
			"import": "./dist/api.js"
		},
		"./cli": {
			"types": "./dist/types/exports/cli.d.ts",
			"import": "./dist/cli.js"
		},
		"./plugin": {
			"types": "./dist/types/exports/plugin.d.ts",
			"import": "./dist/plugin.js"
		},
		"./register": {
			"types": "./dist/types/exports/register.d.ts",
			"import": "./dist/register.js"
		},
		"./schema": "./schema/fatima.schema.json",
		"./eslint": {
			"types": "./dist/types/exports/eslint.d.ts",
			"import": "./dist/eslint.js"
		},
		"./biome": "./dist/biome.grit"
	},
	"typesVersions": {
		"*": {
			".": [
				"./dist/types/exports/runtime.d.ts"
			],
			"./plugin": [
				"./dist/types/exports/plugin.d.ts"
			],
			"./api": [
				"./dist/types/exports/api.d.ts"
			],
			"./register": [
				"./dist/types/exports/register.d.ts"
			],
			"./eslint": [
				"./dist/types/exports/eslint.d.ts"
			]
		}
	},
	"files": [
		"dist",
		"schema"
	],
	"oclif": {
		"bin": "fatima",
		"dirname": "fatima",
		"commands": {
			"strategy": "explicit",
			"target": "./dist/cli.js",
			"identifier": "COMMANDS"
		},
		"topicSeparator": " "
	},
	"scripts": {
		"checktypes": "tsc --noEmit",
		"build": "bun run scripts/build.ts",
		"dev": "bun run --watch src/exports/cli.ts"
	},
	"dependencies": {
		"@inquirer/prompts": "^7.2.4",
		"@oclif/core": "^4.8.3",
		"@opentui/core": "0.2.15",
		"@opentui/react": "0.2.15",
		"chalk": "^5.6.2",
		"comment-json": "^4.2.5",
		"jiti": "2.6.1",
		"log-symbols": "^7.0.1",
		"oclif": "4.22.81",
		"ora": "^9.3.0",
		"react": "19.2.0",
		"react-devtools-core": "7.0.1",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@types/bun": "1.3.13",
		"@types/react": "19.2.0",
		"@types/node": "24.9.1",
		"prettier": "3.6.2"
	}
}
