{
	"name": "fatima",
	"description": "typesafe secrets for the javascript ecosystem",
	"author": "Fernando Coelho",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.0.24",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fgc17/fatima.git"
	},
	"homepage": "https://fatimajs.vercel.app",
	"files": ["dist"],
	"keywords": ["env", "typesafe", "typescript", "environment", "variable"],
	"type": "module",
	"main": "./dist/core/core.cjs",
	"types": "./dist/core/core.d.cts",
	"exports": {
		".": "./dist/core/core.cjs",
		"./register": "./dist/register/register.cjs"
	},
	"typesVersions": {
		"*": {
			".": ["./dist/core/core.d.cts"],
			"./register": ["./dist/register/register.d.cts"]
		}
	},
	"bin": {
		"fatima": "./dist/cli/cli.cjs"
	},
	"scripts": {
		"------------- toolchain -------------": "-------------",
		"format": "biome format --write",
		"lint": "biome lint --error-on-warnings",
		"typecheck": "tsc --noEmit",
		"check": "pnpm typecheck && pnpm lint",
		"test": "vitest",
		"------------- dev -------------": "-------------",
		"dev": "pnpm tsup --env.mode dev",
		"------------- build -------------": "-------------",
		"build": "rm -rf dist && pnpm tsup --env.mode release",
		"bundlesize": "pnpm build --metafile && npm pack --dry-run",
		"bundlesize:dev": "pnpm tsup --metafile && npm pack --dry-run",
		"------------- publishing -------------": "-------------",
		"release": "pnpm check && pnpm build && pnpm publish --no-git-checks",
		"release:rc": "pnpm check && pnpm build && pnpm version prerelease --preid=rc"
	},
	"devDependencies": {
		"@types/node": "^22.9.1",
		"esbuild": "^0.25.1",
		"jiti": "2.4.2",
		"terser": "^5.39.0",
		"tsup": "^8.3.5",
		"typescript": "5.6.3",
		"prettier": "3.5.3",
		"@biomejs/biome": "1.9.4"
	},
	"dependencies": {
		"commander": "13.1.0",
		"jiti": "2.4.2"
	}
}
