{
	"name": "@fatima.dev/core",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "cargo build -p fatima-core --lib",
		"checktypes": "cargo check -p fatima-core --lib",
		"test": "cargo test -p fatima-core",
		"lint": "cargo fmt --all --check"
	},
	"nx": {
		"targets": {
			"build": {
				"cache": true,
				"outputs": ["{workspaceRoot}/target"]
			},
			"checktypes": {
				"cache": true,
				"outputs": ["{workspaceRoot}/target"]
			},
			"test": {
				"cache": true,
				"outputs": ["{workspaceRoot}/target"]
			},
			"lint": {
				"cache": true
			}
		}
	}
}
