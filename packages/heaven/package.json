{
	"name": "@fatimajs/heaven",
	"description": "the heaven client for fatima",
	"author": "Fernando Coelho",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.0.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fgc17/fatima.git"
	},
	"files": ["dist"],
	"type": "module",
	"types": "./dist/heaven.d.cts",
	"main": "./dist/heaven.cjs",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"bundlesize": "pnpm tsup --env.mode release --metafile && npm pack --dry-run",
		"dev": "pnpm tsup --env.mode dev --watch",
		"build": "pnpm tsup --env.mode release && npm pack --dry-run",
		"release": "pnpm typecheck && pnpm publish --no-git-checks"
	},
	"devDependencies": {
		"@types/node": "^22.9.1",
		"terser": "^5.39.0",
		"tsup": "^8.3.5",
		"typescript": "5.6.3"
	}
}
