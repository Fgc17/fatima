{
	"name": "@fatimajs/heaven",
	"description": "the heaven client for fatima",
	"author": "Fernando Coelho",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.0.2",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fgc17/fatima.git"
	},
	"files": ["dist"],
	"type": "module",
	"types": "./dist/heaven.d.cts",
	"main": "./dist/heaven.cjs",
	"scripts": {
		"------------- toolchain -------------": "-------------",
		"format": "biome format --write",
		"lint": "biome lint --error-on-warnings",
		"typecheck": "tsc --noEmit",
		"check": "pnpm typecheck && pnpm lint",
		"test": "vitest",
		"------------- dev -------------": "-------------",
		"dev": "pnpm tsup --env.mode dev",
		"------------- build -------------": "-------------",
		"build": "rm -rf dist && pnpm tsup --env.mode release",
		"bundlesize": "pnpm build --metafile && npm pack --dry-run",
		"bundlesize:dev": "pnpm tsup --metafile && npm pack --dry-run",
		"------------- publishing -------------": "-------------",
		"release": "pnpm check && pnpm build && pnpm publish --no-git-checks",
		"release:rc": "pnpm check && pnpm build && pnpm version prerelease --preid=rc"
	},
	"devDependencies": {
		"@types/node": "^22.9.1",
		"terser": "^5.39.0",
		"tsup": "^8.3.5",
		"typescript": "5.6.3"
	}
}
