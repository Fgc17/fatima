{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".astro/**"]
		},
		"@fatima.dev/js#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/Cargo.lock",
				"$TURBO_ROOT$/Cargo.toml",
				"$TURBO_ROOT$/crates/**",
				"!$TURBO_ROOT$/crates/**/target/**"
			],
			"outputs": ["dist/**"]
		},
		"@fatima.dev/js#build:prebuilt": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/.release/raw/wasm-pack/fatima_wasm.js",
				"$TURBO_ROOT$/.release/raw/wasm-pack/fatima_wasm.d.ts",
				"$TURBO_ROOT$/.release/raw/wasm/fatima_wasm_bg.wasm"
			],
			"outputs": ["dist/**"]
		},
		"checktypes": {
			"dependsOn": ["^checktypes"],
			"outputs": []
		},
		"lint": {
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
