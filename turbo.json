{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"format": {
			"dependsOn": ["^format"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist"],
			"cache": true
		},
		"release": {
			"dependsOn": ["fatima#build", "create-fatima#build"]
		}
	}
}
