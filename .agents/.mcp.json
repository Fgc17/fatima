{
	"mcpServers": {
		"context7": {
			"headers": {
				"CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
			},
			"type": "http",
			"url": "https://mcp.context7.com/mcp"
		},
		"gitnexus": {
			"args": ["-y", "gitnexus@1.6.9", "mcp"],
			"command": "npx",
			"type": "stdio"
		},
		"grepapp": {
			"type": "http",
			"url": "https://mcp.grep.app"
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "Bearer ${GITHUB_API_KEY}"
			}
		}
	}
}
